{
  "type": "apoli:multiple",
  "name": "Collector's Rush",
  "description": "Gain speed and haste from discovering new items. Your collection drive drains over time - keep finding new items to maintain the buffs!",
  "collection_charge": {
    "type": "apoli:resource",
    "name": "esspack:collection_charge",
    "min": 0,
    "max": 600,
    "initial_value": 450,
    "hud_render": {
      "should_render": true,
      "sprite_location": "apoli:textures/gui/resource_bar.png",
      "bar_index": 2,
      "condition": {
        "type": "apoli:resource",
        "resource": "esspack:allay_essence/hoarder_lifestyle_collection_charge",
        "comparison": "<",
        "compare_to": 600
      }
    }
  },
  "drain": {
    "type": "apoli:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "apoli:change_resource",
      "resource": "esspack:allay_essence/hoarder_lifestyle_collection_charge",
      "change": -1
    }
  },
  "low_charge_warning": {
    "type": "apoli:action_over_time",
    "interval": 1200,
    "condition": {
      "type": "apoli:resource",
      "resource": "esspack:allay_essence/hoarder_lifestyle_collection_charge",
      "comparison": "<=",
      "compare_to": 0
    },
    "entity_action": {
      "type": "apoli:execute_command",
      "command": "title @s actionbar {\"text\":\"Collection Drive Empty - Hunt for new items!\",\"color\":\"red\"}"
    }
  },
  "low_charge_mana_drain": {
    "type": "apoli:conditioned_attribute",
    "condition": {
      "type": "apoli:resource",
      "resource": "esspack:allay_essence/hoarder_lifestyle_collection_charge",
      "comparison": "<=",
      "compare_to": 0
    },
    "modifier": {
      "id": "esspack:low_collection_mana_drain",
      "attribute": "essencelib:mana_regen",
      "operation": "ADD_VALUE",
      "amount": -1,
      "name": "Low collection mana drain"
    }
  },
  "low_charge_stamina_drain": {
    "type": "apoli:conditioned_attribute",
    "condition": {
      "type": "apoli:resource",
      "resource": "esspack:allay_essence/hoarder_lifestyle_collection_charge",
      "comparison": "<=",
      "compare_to": 0
    },
    "modifier": {
      "id": "esspack:low_collection_stamina_drain",
      "attribute": "puffish_attributes:player.stamina",
      "operation": "ADD_MULTIPLIED_TOTAL",
      "amount": -0.15,
      "name": "Low collection stamina drain"
    }
  },
  "boost_effects": {
    "type": "apoli:action_over_time",
    "interval": 20,
    "condition": {
      "type": "apoli:resource",
      "resource": "esspack:allay_essence/hoarder_lifestyle_collection_charge",
      "comparison": ">=",
      "compare_to": 450
    },
    "entity_action": {
      "type": "apoli:apply_effect",
      "effects": [
        {
          "id": "minecraft:haste",
          "amplifier": 0,
          "duration": 40,
          "is_ambient": true,
          "show_particles": false
        },
        {
          "id": "minecraft:speed",
          "amplifier": 0,
          "duration": 40,
          "is_ambient": true,
          "show_particles": false
        }
      ]
    }
  },
  "high_charge_boost": {
    "type": "apoli:action_over_time",
    "interval": 20,
    "condition": {
      "type": "apoli:resource",
      "resource": "esspack:allay_essence/hoarder_lifestyle_collection_charge",
      "comparison": ">=",
      "compare_to": 525
    },
    "entity_action": {
      "type": "apoli:apply_effect",
      "effects": [
        {
          "id": "minecraft:haste",
          "amplifier": 1,
          "duration": 40,
          "is_ambient": true,
          "show_particles": false
        },
        {
          "id": "minecraft:speed",
          "amplifier": 1,
          "duration": 40,
          "is_ambient": true,
          "show_particles": false
        }
      ]
    }
  },
  "high_charge_mana_regen": {
    "type": "apoli:conditioned_attribute",
    "condition": {
      "type": "apoli:resource",
      "resource": "esspack:allay_essence/hoarder_lifestyle_collection_charge",
      "comparison": ">=",
      "compare_to": 450
    },
    "modifier": {
      "id": "esspack:high_collection_mana_regen",
      "attribute": "essencelib:mana_regen",
      "operation": "ADD_VALUE",
      "amount": 8,
      "name": "High collection mana regen"
    }
  },
  "item_cooldown": {
    "type": "apoli:action_over_time",
    "interval": 6000,
    "entity_action": {
      "type": "apoli:execute_command",
      "command": "execute if data storage esspack:memory RecentItems[0] run data remove storage esspack:memory RecentItems[0]"
    }
  },
  "hidden": true
}



