{
  "type": "apoli:multiple",
  "name": "Magnetic Collection",
  "description": "Channel your essence to pull nearby items toward you. Active while held. Costs 10 mana per second.",
  "magnet_resource": {
    "type": "apoli:resource",
    "name": "esspack:magnet_active",
    "min": 0,
    "max": 300,
    "initial_value": 0
  },
  "pull_loop": {
    "type": "apoli:action_over_time",
    "interval": 1,
    "condition": {
      "type": "apoli:resource",
      "resource": "esspack:allay_essence/activepull_magnet_resource",
      "comparison": ">",
      "compare_to": 0
    },
    "entity_action": {
      "type": "apoli:sequence",
      "actions": [
        {
          "type": "apoli:area_of_effect",
          "radius": 28,
          "bientity_action": {
            "type": "apoli:add_velocity",
            "z": -0.6
          },
          "bientity_condition": {
            "type": "apoli:target_condition",
            "condition": {
              "type": "apoli:entity_type",
              "entity_type": "minecraft:item"
            }
          }
        },
        {
          "type": "apoli:change_resource",
          "resource": "esspack:allay_essence/activepull_magnet_resource",
          "change": -1
        }
      ]
    }
  },
  "hidden": true
}
