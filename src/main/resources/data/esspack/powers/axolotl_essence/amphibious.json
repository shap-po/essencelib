{
  "type": "apoli:multiple",
  "name": "Amphibious",
  "description": "Breathe underwater and see clearly while submerged. Water speed is improved by your essence attributes.",
  "water_breathing": {
    "type": "apoli:action_over_time",
    "interval": 40,
    "condition": {
      "type": "origins:submerged_in",
      "fluid": "minecraft:water"
    },
    "entity_action": {
      "type": "apoli:execute_command",
      "command": "effect give @s minecraft:water_breathing 3 0 true"
    }
  },
  "night_vision_underwater": {
    "type": "apoli:action_over_time",
    "interval": 40,
    "condition": {
      "type": "origins:submerged_in",
      "fluid": "minecraft:water"
    },
    "entity_action": {
      "type": "apoli:execute_command",
      "command": "effect give @s minecraft:night_vision 3 0 true"
    }
  }
}
