{
  "type": "apoli:multiple",
  "name": "Threat Rhythm",
  "description": "Resolve rises while enemies are focused on you and falls when threat slips away. Stable resolve rewards true frontline play.",
  "resolve": {
    "type": "apoli:resource",
    "name": "esspack:threat_rhythm_resolve",
    "min": 0,
    "max": 100,
    "initial_value": 50
  },
  "aggro_timer": {
    "type": "apoli:resource",
    "name": "esspack:threat_rhythm_aggro_timer",
    "min": 0,
    "max": 100,
    "initial_value": 0
  },
  "chased_state": {
    "type": "apoli:resource",
    "name": "esspack:threat_rhythm_chased_state",
    "min": 0,
    "max": 100,
    "initial_value": 0
  },
  "gain_aggro_when_targeted": {
    "type": "apoli:self_action_when_hit",
    "cooldown": 5,
    "damage_condition": {
      "type": "apoli:attacker"
    },
    "entity_action": {
      "type": "apoli:change_resource",
      "resource": "esspack:armadillo_essence/threat_rhythm_lifestyle_aggro_timer",
      "change": 60
    }
  },
  "pull_threat_when_striking": {
    "type": "apoli:self_action_on_hit",
    "cooldown": 10,
    "entity_action": {
      "type": "apoli:sequence",
      "actions": [
        {
          "type": "apoli:change_resource",
          "resource": "esspack:armadillo_essence/threat_rhythm_lifestyle_aggro_timer",
          "change": 14
        },
        {
          "type": "apoli:change_resource",
          "resource": "esspack:armadillo_essence/threat_rhythm_lifestyle_resolve",
          "change": 6
        }
      ]
    }
  },
  "decay_aggro_timer": {
    "type": "apoli:action_over_time",
    "interval": 3,
    "condition": {
      "type": "apoli:resource",
      "resource": "esspack:armadillo_essence/threat_rhythm_lifestyle_aggro_timer",
      "comparison": ">",
      "compare_to": 0
    },
    "entity_action": {
      "type": "apoli:change_resource",
      "resource": "esspack:armadillo_essence/threat_rhythm_lifestyle_aggro_timer",
      "change": -1
    }
  },
  "decay_chased_state": {
    "type": "apoli:action_over_time",
    "interval": 1,
    "condition": {
      "type": "apoli:resource",
      "resource": "esspack:armadillo_essence/threat_rhythm_lifestyle_chased_state",
      "comparison": ">",
      "compare_to": 0
    },
    "entity_action": {
      "type": "apoli:change_resource",
      "resource": "esspack:armadillo_essence/threat_rhythm_lifestyle_chased_state",
      "change": -1
    }
  },
  "drain_resolve_when_safe": {
    "type": "apoli:action_over_time",
    "interval": 20,
    "condition": {
      "type": "apoli:resource",
      "resource": "esspack:armadillo_essence/threat_rhythm_lifestyle_aggro_timer",
      "comparison": "<=",
      "compare_to": 0
    },
    "entity_action": {
      "type": "apoli:change_resource",
      "resource": "esspack:armadillo_essence/threat_rhythm_lifestyle_resolve",
      "change": -4
    }
  },
