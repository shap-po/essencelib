    "type": "apoli:action_over_time",
    "interval": 1,
    "condition": {
      "type": "apoli:resource",
      "resource": "esspack:armadillo_essence/armadillo_ball_up_ball_state",
      "comparison": ">",
      "compare_to": 0
    },
    "entity_action": {
      "type": "apoli:execute_command",
      "command": "effect give @s minecraft:resistance 1 0 true"
    }
  },
  "hidden": true
